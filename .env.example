# Credenciais PÚBLICAS do Supabase (seguras para o navegador).
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publishable_aqui

# URL pública do app, usada nos links de e-mail (confirmação e recuperação de senha).
# Em produção na Vercel: https://SEU-APP.vercel.app  (opcional: sem ela, usa o endereço aberto no navegador)
# Em desenvolvimento local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Provedor de IA (opcional). Sem chave, o JARVIS usa o provedor local de regras.
# Estas variáveis são SOMENTE de servidor: nunca use o prefixo NEXT_PUBLIC_.
AI_PROVIDER=rules
# ANTHROPIC_API_KEY=

# --- Android / Capacitor (usado no GitHub Actions, não no navegador) ---
# URL do app hospedado que o APK carrega. Defina como "Variable" no GitHub: JARVIS_APP_URL
# Exemplo: https://SEU-APP.vercel.app/app
